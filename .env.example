# BFF base URL used by the dev server. In Docker/Cloudflare, this value is
# baked into the build via the VITE_API_BASE_URL build arg. Production API:
# https://api.buget.cristian-nichifor.com
VITE_API_BASE_URL=http://localhost:3000

# Contributor default: bundled demo data, no BFF or upstream requests.
# Use remote to exercise the local BFF configured above.
VITE_DATA_MODE=static
